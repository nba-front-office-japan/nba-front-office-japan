# このファイルは環境変数の「名前一覧」です。実際の値は書かず、.env.local や
# Vercelの環境変数設定にのみ実際の値を入れてください。

# --- Supabase（必須・既存のStats DBと共通） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- balldontlie API（scripts/import-players.ts など、選手データ投入スクリプト専用。
#     デプロイ済みサイト自体の動作には不要） ---
BALLDONTLIE_API_KEY=

# --- News Collector v1 Phase B（今回追加） ---
# /admin/news の暫定Basic認証パスワード（Phase DでSupabase Auth認証に置き換え予定）
ADMIN_BASIC_AUTH_PASSWORD=
# Vercel CronからのRSS収集リクエストを認証するための秘密文字列
CRON_SECRET=

# --- 以下はPhase C以降で使用予定（現時点ではコード未実装・設定不要） ---
# NEWS_AI_API_KEY=
# NEWS_AI_MODEL=
# ADMIN_EMAIL_ALLOWLIST=
# X_API_BEARER_TOKEN=
